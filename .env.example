# =============================================================================
# Alpha Backend — environment configuration
#
# Copy to `.env` and adjust. `.env` is gitignored; this file is committed.
#
# READ THIS FIRST
# ---------------
# This backend runs on the END USER'S MACHINE. It is not a trusted server.
# In a packaged desktop build, anything in this file is readable by whoever
# has the machine. Therefore:
#
#   * This file holds CONFIGURATION, never credentials.
#   * AI provider auth comes from the installed CLIs (`claude`, `codex`),
#     which authenticate themselves. Alpha stores no AI keys. Ever.
#   * GitHub auth comes from `gh auth login`, stored in the OS keyring.
#   * User session tokens go in the OS keychain, NOT here.
#
# If you ever feel the need to add a secret below, that is a signal the
# design is drifting — the secret belongs in the keychain or on a real
# server, not in a file shipped to users.
# =============================================================================


# --- Server ------------------------------------------------------------------

# Port for the local API + WebSocket server.
PORT=3001

# Interface to bind. Keep this at 127.0.0.1.
#
# 0.0.0.0 exposes the API to every device on your network — and this API can
# spawn agents that run shell commands. On shared wifi that is remote code
# execution for anyone who can reach the port.
HOST=127.0.0.1

# Comma-separated allowlist of browser origins permitted to call the API.
# Do NOT use "*": any website you visit could then drive your local agents
# from the page's JavaScript. There is no built-in default: unset admits no
# browser origin at all.
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# REQUIRED. The GitHub organisation whose teams decide roles
# (developers → dev, project-managers → pm, admin/admins → admin).
# The daemon refuses to start without it — there is no default org.
ALPHA_ORG=

# Shared secret the frontend sends as `X-Alpha-Token` on every request.
# Generated on first launch and written to ~/.alpha/runner-token if unset.
# Prevents other local processes from driving the agent runner.
ALPHA_LOCAL_TOKEN=


# --- Storage -----------------------------------------------------------------

# SQLite database location. Defaults to ~/.alpha/alpha.db
# SQLITE_DB_PATH=

# There is no DATABASE_URL here, on purpose. It is the cloud's connection, it
# contains the database password, and it connects past every RLS policy. The
# desktop reaches the shared database only through a short-lived token for
# your own login (see ALPHA_CLOUD_API), and warns at startup if it finds one.


# --- Execution limits (override src/config/constants.ts) ----------------------

# WALL_CLOCK_TIMEOUT_MS=900000
# IDLE_TIMEOUT_MS=120000
# MAX_TURNS=25


# --- GitHub (DELIBERATELY EMPTY on desktop) ----------------------------------
#
# There is no GITHUB_TOKEN, GITHUB_CLIENT_ID or GITHUB_CLIENT_SECRET here, and
# that is not an oversight. `gh auth login --web` performs the OAuth 2.0 Device
# Authorization Grant using GitHub CLI's own registration. Device flow is a
# public client: no client secret exists in the spec, and no callback URL is
# needed because the client polls GitHub rather than receiving a redirect. The
# resulting token is written to the OS credential store by `gh`; Alpha shells
# out to `gh` and never reads it.
#
# One variable DOES affect this, and it is a trap rather than a setting:
#
#   GH_TOKEN / GITHUB_TOKEN — if either is set in the environment, `gh` uses it
#   INSTEAD of the keyring. A stale value there makes every GitHub call 401
#   while a perfectly good saved login sits unused, and signing in again cannot
#   fix it because the variable keeps winning. Settings > Connected Accounts
#   detects this and tells the user to clear it. Do not set it here.
#
# THE HOSTED DEPLOYMENT IS DIFFERENT. A Render container has no `gh`, no
# keyring and no interactive session, so it must carry its own OAuth App:
# GITHUB_CLIENT_ID, GITHUB_CLIENT_SECRET, GITHUB_CALLBACK_URL and
# GITHUB_SCOPE=repo,workflow,read:org. Those belong in the SERVER environment
# only, never in a build shipped to users. See SUPABASE_AND_HOSTING_PLAN.md
# §1.5.4b.
#
# The code reads these names, so they are listed here for discoverability. LEAVE
# THEM BLANK on any machine that is not the Render service:
#
#   GITHUB_CLIENT_ID           OAuth App id.               server only
#   GITHUB_CLIENT_SECRET       OAuth App secret.           server only, HIGH
#   GITHUB_CALLBACK_URL        must match the App exactly. server only
#   GITHUB_SCOPE               repo,workflow,read:org      server only
#   GITHUB_APP_ID              GitHub App id.              server only
#   GITHUB_APP_PRIVATE_KEY     RSA private key.            server only, HIGH
#   GITHUB_APP_SLUG            App slug for install links. server only
#   GITHUB_APP_WEBHOOK_SECRET  webhook HMAC key.           server only, HIGH
#
# GITHUB_APP_WEBHOOK_SECRET is not optional on a deployment that receives
# webhooks: /api/github/app/webhook now REFUSES every delivery when it is unset,
# because without it a signature cannot be verified and the endpoint is public.
# Fail closed is deliberate — see githubService.handleGitHubAppWebhook.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=
GITHUB_SCOPE=repo,workflow,read:org
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_SLUG=
GITHUB_APP_WEBHOOK_SECRET=


# --- CI templates (BOTH the Render service and every desktop build) ----------
#
# Where provisioned repositories get their CI from: the reusable-workflow
# repository as owner/name, and the tag its caller templates are read at.
# Public values — the desktop build copies them into the installer. Required:
# with either one blank, scaffolding refuses before creating a repository.
ALPHAORCH_WORKFLOW_REPO=
ALPHAORCH_WORKFLOW_REF=


# --- Hosting (CLOUD ONLY — the Render service, never a desktop) --------------
#
# Automatic Render + Vercel hosting for repositories Alpha provisions. Read
# only in cloud mode; a desktop reaches this by forwarding the request to
# ALPHA_CLOUD_API with its own GitHub token, the same way it reaches every
# other cloud-only capability. Leave every value below blank on any machine
# that is not the Render service — a token here can create billed
# infrastructure, which is exactly what must never ship to a teammate's
# desktop.

# Render API key (dashboard → Account Settings → API Keys).
RENDER_API_KEY=

# Optional. The Render owner (workspace) new services are created under. When
# unset, the first team owner GET /v1/owners returns is used, so a single-team
# Render account needs no value here.
RENDER_OWNER_ID=

# Optional. Region for new Render services (e.g. oregon, frankfurt, singapore).
# Leave blank to let Render choose its own default.
RENDER_REGION=

# Vercel API token (Account Settings → Tokens).
VERCEL_TOKEN=

# Required once the token belongs to a team account; a personal-account token
# needs no team. Dashboard → Settings → General → Team ID.
VERCEL_TEAM_ID=


# --- Supabase (OPTIONAL — team mode only) ------------------------------------
#
# Leave every value below blank for solo mode. With no Supabase configured the
# app runs entirely on local SQLite, which is the recommended starting point:
# no cloud surface means no cloud attack surface.

# Project URL. Public, safe to ship.
SUPABASE_URL=

# The ANON key. Public by design — it is embedded in the frontend bundle and
# readable by anyone. It is only safe because Row Level Security constrains
# what it can reach. See SUPABASE_AND_HOSTING_PLAN.md §2.5.
SUPABASE_ANON_KEY=

# Desktop only: the same-origin Vercel API proxy used for database tokens and
# account-specific GitHub OAuth, e.g. https://alpha-fe-main.vercel.app/api.
# Vercel forwards /api to Render via API_ORIGIN. The desktop presents its
# Alpha credential and the cloud decides the role.
ALPHA_CLOUD_API=

# !!! SUPABASE_JWT_SECRET is CLOUD ONLY — never put it in a desktop .env. !!!

#
# Whoever holds it can sign a token with any role for any workspace, which
# makes every RLS policy advisory. The desktop used to need it to sign its own
# tokens; it now gets them from ALPHA_CLOUD_API, and minting refuses to run
# outside cloud mode even when the secret is present.

# !!! DO NOT ADD SUPABASE_SERVICE_ROLE_KEY TO THIS FILE. !!!
#
# The service role key BYPASSES Row Level Security completely. It grants full
# read/write over every row belonging to every user. It must never be placed
# in the desktop app, the frontend, or any artifact distributed to users.
#
# It belongs only on a server you control, or in CI secrets for running
# migrations. If you need one for migrations, keep it in your shell session or
# your CI provider's secret store — not here.
#
# The runner does NOT need it: it signs in as the owning user and operates
# under that user's RLS policies, exactly like the browser does.

# Phase 3 acknowledgment email: CLOUD/HOSTED BACKEND ONLY, never desktop/Vite.
# Keep disabled until the selected email provider and sender are configured.
# Only inquiries created while this switch is 1 are enrolled; no old backlog sends.
ALPHA_TICKETING_ACK_EMAIL_ENABLED=0
# Resend is the default; Brevo remains an explicit alternative. No automatic fallback.
TICKET_ACK_EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_SENDER_EMAIL=
RESEND_SENDER_NAME=
# Required with onboarding@resend.dev: exact Resend account email, approved for testing.
# Optional recipient restriction with a verified domain. Never redirects other receipts.
RESEND_TEST_RECIPIENT=
# Only needed when TICKET_ACK_EMAIL_PROVIDER=brevo.
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
